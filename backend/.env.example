# Copy this file to .env and fill in each value. Never share .env.
DATABASE_URL=mysql://user:password@host:3306/dbname
PORT=4000
# Comma-separated web addresses allowed to call this backend
CORS_ORIGINS=http://localhost:3000
# Long random text (at least 32 characters) for login sessions
JWT_SECRET=
# 64 hex characters. Encrypts PAN, bank numbers and social tokens. Back this up: if lost, that data cannot be read.
ENCRYPTION_KEY=
# Secret that scheduled jobs must present
JOBS_SECRET=
# First admin account, created by npm run db:setup
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# YouTube Data API
YOUTUBE_API_KEY=
# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v25.0

# Email through Brevo (forgotten passwords and alerts)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Lotus Electronics Supermarket
# The site's web address, used in emailed links
PUBLIC_URL=
# Testing only: the word off removes the admin phone code. Delete this before real use.
ADMIN_TWO_STEP=
